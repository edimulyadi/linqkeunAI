# Copy this file to .env at the project root, then run:
#   npm run setup:env   (symlinks this .env into apps/web and packages/database)
#
# ── Database ────────────────────────────────────────────────────────────────
# Any Postgres connection string works — Supabase, Neon, RDS, or the local
# docker-compose Postgres (see docker-compose.yml).
DATABASE_URL="postgresql://linqkeun:linqkeun@localhost:5432/linqkeun_ai?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# ── AI provider (Anthropic Claude) ──────────────────────────────────────────
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ── Seed admin account (used by `npm run db:seed`) ──────────────────────────
SEED_ADMIN_EMAIL="admin@linqkeun.ai"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
